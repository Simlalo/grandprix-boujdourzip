}
span.bold\+color_orange{
	color:#FFA500;
	font-weight:Bold;
}
span.bold\+superscript\+color_red{
	color:#FF0000;
	vertical-align:Super;
	font-size:80%;
	font-weight:Bold;
}
span.bold\+superscript\+color_orange{
	color:#FFA500;
	vertical-align:Super;
	font-size:80%;
	font-weight:Bold;
}
span.bold\+no_break{
